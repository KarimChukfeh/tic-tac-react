{
  "name": "tic-tac-react",
  "version": "1.0.0",
  "description": "TicTacToe dApp - Provably Fair, Zero Trust, 100% On-Chain",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run v3:sdk:check && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "v3:sdk:sync": "node scripts/sync-v3-sdk.js && node scripts/generate-v3-sdk-browser.js",
    "v3:sdk:browser": "node scripts/generate-v3-sdk-browser.js",
    "v3:sdk:check": "node scripts/sync-v3-sdk.js --check && node scripts/generate-v3-sdk-browser.js --check",
    "v3:security:check": "node scripts/check-v3-security.js",
    "v3:release:check": "npm run v3:sdk:check && vitest run src/v3 src/history/generationHistory.test.js && npm run build && npm run v3:security:check",
    "v3:bundlers": "node scripts/v3-local-bundlers.js",
    "v3:tictactoe:accept": "node scripts/v3-tictactoe-acceptance.js tictactoe",
    "v3:connect4:accept": "node scripts/v3-tictactoe-acceptance.js connectfour",
    "v3:chess:accept": "node scripts/v3-tictactoe-acceptance.js chess",
    "v3:transport:accept": "node scripts/v3-transport-resilience.js",
    "v3:lifecycle:accept": "node scripts/v3-session-lifecycle-acceptance.js"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "ethers": "^6.9.0",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.5",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "jsdom": "^27.2.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.8",
    "vitest": "^4.0.10"
  }
}
