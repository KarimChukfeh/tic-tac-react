# V2 network configuration
# Defaults now follow the active ABI manifest in src/v2/ABIs/*.json
# Current default deployment target: Arbitrum One
VITE_NETWORK=arbitrumOne

# Optional V2 RPC override
# Preferred variable: VITE_V2_RPC_URL
# Legacy fallback still supported: VITE_RPC_URL
VITE_V2_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/yoftG-myZ5Iur7UklgbJR

# Used server-side by the V3 ETH/USD price proxy. Never prefix this with VITE_.
ETHERSCAN_API_KEY=your_etherscan_api_key

# V3 deployment bundle. Only the exact value PRODUCTION selects Arbitrum One.
# Leave unset for localhost development.
# ENVIRONMENT=PRODUCTION

# Required alongside ENVIRONMENT=PRODUCTION. Prefer same-origin server proxies
# so provider credentials are not embedded in the browser bundle.
# VITE_V3_RPC_URL=https://your-reviewed-v3-rpc.example
# VITE_V3_BUNDLER_URL_PRIMARY=https://your-primary-bundler.example
# VITE_V3_BUNDLER_URL_FAILOVER=https://your-failover-bundler.example
# VITE_V3_SPONSORSHIP_ENABLED=true

# Local override example:
# VITE_NETWORK=localhost
# VITE_V2_RPC_URL=http://127.0.0.1:8545
